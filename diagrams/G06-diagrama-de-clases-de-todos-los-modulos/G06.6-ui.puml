@startuml
title G06 - Capa UI / PRESENTATION

left to right direction
skinparam classAttributeIconSize 0
hide circle

package "Aspectos técnicos" {

    class Program <<static>> {
        - {static} Main() : void
    }

    class FrmPrincipal <<Form, IObservador>> {
        - _sesionIdioma : SesionIdioma
        --
        + Actualizar(idiomaObservado : IIdioma) : void
        - TSMI_Clientes_Click(...) : void
        - TSMI_Equipos_Click(...) : void
        - TSMI_Ordenes_Click(...) : void
        - TSMI_Compras_Click(...) : void
        - TSMI_Garantias_Click(...) : void
        - TSMI_Dashboard_Click(...) : void
        - TSMI_Reportes_Click(...) : void
    }

    class FrmLogin <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }

    class FrmAdministrarUsuarios <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }

    class FrmAdministrarPermisos <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }

    class FrmAsignarPermisosUsuario <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }

    class FrmBitacora <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }

    class FrmControlCambios <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }

    class FrmAdministrarTraducciones <<Form, IObservador>> {
        + Actualizar(idiomaObservado : IIdioma) : void
    }
}

