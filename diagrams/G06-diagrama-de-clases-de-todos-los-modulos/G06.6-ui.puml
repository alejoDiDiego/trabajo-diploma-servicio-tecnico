    - ActualizarMenuUsuario() : void
    - CargarMenuIdiomas() : void
    - CambiarIdioma(idIdioma : int) : void
    - CerrarFormulariosHijos() : void
    - TSMI_Ordenes_Click(sender, e) : void
  }
}

