}

package "Negocio - Órdenes" {

    class FrmOrdenesServicio <<Form, IObservador>> {
        - _service : OrdenServicioService
        - _clienteService : ClienteService
        - _equipoService : EquipoService
        --
        + Actualizar(idiomaObservado : IIdioma) : void
        - EsSoloConsulta(idOrden : int) : bool
        - BTN_Cancelar_Click(...) : void
        - BTN_Entregar_Click(...) : void
    }

    class FrmOrdenServicioDetalle <<Form, IObservador>> {
        - _service : OrdenServicioService
        - _garantiaService : GarantiaService
        - _clienteService : ClienteService
        - _equipoService : EquipoService
        - _idOrden : int
        - _esNuevo : bool
        - _tabInicial : string
        - _repuestosPresupuesto : List<Repuesto>
        - _idIntervencionPruebaCargada : int
        - _cargandoPruebas : bool
        - _reingresos : List<OrdenServicio>
        - _soloConsulta : bool
        --
        + FrmOrdenServicioDetalle()
        + FrmOrdenServicioDetalle(idOrden : int)
        + FrmOrdenServicioDetalle(idOrden : int, tabInicial : string)
        + Actualizar(idiomaObservado : IIdioma) : void
        - CargarComboRepuestosPresupuesto() : void
        - ActualizarAccionesPruebas() : void
        - CargarReingresosGarantia() : void
        - ActualizarAvisoSoloConsulta() : void
        - AplicarPermisosDetalle() : void
        - BTN_RechazarGarantia_Click(...) : void
        - BTN_CancelarEntrega_Click(...) : void
    }

    class FrmGarantias <<Form, IObservador>> {
        - _ordenService : OrdenServicioService
        - _garantiaService : GarantiaService
        - _clienteService : ClienteService
        - _equipoService : EquipoService
        --
        + Actualizar(idiomaObservado : IIdioma) : void
