package "Aspectos técnicos - Excepciones" {

    class ReglaNegocioException <<Exception>>
    class UsuarioYaExisteException <<Exception>>
    class UsuarioNoExisteException <<Exception>>

    class ClienteDocumentoDuplicadoException <<Exception>> {
        + Documento : string
        + IdClienteExistente : int
        + NombreExistente : string
        + ApellidoExistente : string
        + ActivoExistente : bool
        + TienePropietario : bool
        + NombrePropietario : string
    }

    class DetallePresupuestoInvalidoException <<Exception>> {
        + ClaveMensaje : string
    }

    class OrdenOriginalSoloConsultaException <<Exception>> {
        + ClaveMensaje : string
    }

    class ReingresoGarantiaAbiertoException <<Exception>> {
        + ClaveMensaje : string
    }

    class ReingresoGarantiaOrigenNoDisponibleException <<Exception>> {
        + ClaveMensaje : string
    }
}

package "Constantes del dominio" {

    class EstadoOrdenServicio <<static>>
    class ResultadoOrdenServicio <<static>>
    class TipoOrden <<static>>
    class EstadoPresupuesto <<static>>
    class TipoPresupuesto <<static>>
    class TipoItemPresupuesto <<static>>
    class ResultadoPrueba <<static>>
    class TipoMovimientoStock <<static>>
    class EstadoCompra <<static>>
    class EstadoEvaluacionGarantia <<static>>
    class CodigosPermiso <<static>>
}

' Asociaciones conceptuales por identificadores.
' No representan propiedades de navegacion ni composicion.

Cliente "1" -- "0..*" Equipo
TipoEquipo "1" -- "0..*" Equipo
Marca "1" -- "0..*" Equipo

Cliente "1" -- "0..*" OrdenServicio
Equipo "1" -- "0..*" OrdenServicio

' Una orden puede tener 0..1 origen; un origen puede tener 0..* reingresos.
' Solo se permite un reingreso abierto por origen a la vez.
' Con cualquier reingreso creado, el origen queda de solo consulta.
' Estas restricciones se aplican en APPLICATION/REPOSITORY.
OrdenServicio "0..*" --> "0..1" OrdenServicio : origen

OrdenServicio "1" -- "0..1" Diagnostico
OrdenServicio "1" -- "1..*" HistorialEstadoOrden
OrdenServicio "1" -- "0..*" Presupuesto
Presupuesto "1" -- "0..*" DetallePresupuesto
OrdenServicio "1" -- "0..1" Entrega

' Referencia comercial opcional: cotizar no reserva ni consume stock.
Repuesto "0..1" -- "0..*" DetallePresupuesto

OrdenServicio "1" -- "0..*" Reparacion
Reparacion "1" -- "0..*" Prueba
Reparacion "1" -- "0..*" ReparacionRepuesto
Repuesto "1" -- "0..*" ReparacionRepuesto
Repuesto "1" -- "0..*" MovimientoStock

Proveedor "1" -- "0..*" Compra
Compra "1" -- "0..*" DetalleCompra
Repuesto "1" -- "0..*" DetalleCompra

' La cobertura es unica por orden original; los reingresos son otras ordenes.
OrdenServicio "1" -- "0..1" Garantia
Garantia "1" -- "0..*" EvaluacionGarantia
OrdenServicio "1" -- "0..1" EvaluacionGarantia

IUsuario <|.. Usuario
IPermisoComponent <|.. PermisoComponent
PermisoComponent <|-- PermisoSimple
PermisoComponent <|-- FamiliaPermiso

' Un componente puede ser compartido por varias familias.
FamiliaPermiso "0..*" --> "0..*" IPermisoComponent

IIdioma <|.. Idioma
IPalabra <|.. Palabra
ITraduccion <|.. Traduccion
Idioma "1" --> "0..*" ITraduccion
Traduccion --> IPalabra

Exception <|-- ReglaNegocioException
Exception <|-- UsuarioYaExisteException
Exception <|-- UsuarioNoExisteException

ReglaNegocioException <|-- ClienteDocumentoDuplicadoException
ReglaNegocioException <|-- DetallePresupuestoInvalidoException
ReglaNegocioException <|-- OrdenOriginalSoloConsultaException
ReglaNegocioException <|-- ReingresoGarantiaAbiertoException
ReglaNegocioException <|-- ReingresoGarantiaOrigenNoDisponibleException

OrdenServicio ..> EstadoOrdenServicio
OrdenServicio ..> ResultadoOrdenServicio
OrdenServicio ..> TipoOrden
Presupuesto ..> EstadoPresupuesto
Presupuesto ..> TipoPresupuesto
DetallePresupuesto ..> TipoItemPresupuesto
Prueba ..> ResultadoPrueba
MovimientoStock ..> TipoMovimientoStock
Compra ..> EstadoCompra
EvaluacionGarantia ..> EstadoEvaluacionGarantia

@enduml
