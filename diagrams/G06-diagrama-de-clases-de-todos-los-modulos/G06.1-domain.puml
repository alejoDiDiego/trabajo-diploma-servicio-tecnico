package "Aspectos técnicos - Seguridad y permisos" {

    class Usuario {
        + Id : int
        + Username : string
        + Password : string
        + Activo : bool
        + DVH : string
        --
        + {static} CrearNuevo(...) : Usuario
        + {static} CargarDesdeDB(...) : Usuario
        + Desactivar() : void
        + Reactivar() : void
        + SetDVH(...) : void
    }

    class UserDVH <<DTO>> {
        + Id : int
        + DVH : string
    }

    abstract class PermisoComponent {
        + Id : int
        + Nombre : string
        + Codigo : string
        + {abstract} EsFamilia : bool
        + Hijos : IList<IPermisoComponent>
        --
        + Contiene(...) : bool
        + {abstract} AgregarHijo(...) : void
    }

    class PermisoSimple {
        + EsFamilia : bool
        + {static} CargarDesdeDB(...) : PermisoSimple
        + AgregarHijo(...) : void
    }

    class FamiliaPermiso {
        + EsFamilia : bool
        + {static} CrearNuevo(...) : FamiliaPermiso
        + {static} CargarDesdeDB(...) : FamiliaPermiso
        + AgregarHijo(...) : void
        + Contiene(...) : bool
    }

    interface IUsuario
    interface IPermisoComponent
}

