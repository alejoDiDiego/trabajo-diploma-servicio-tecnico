@startuml
title N02-11 - Secuencia de Gestión de garantías y reingresos
autonumber
hide footbox
actor "Recepcionista, técnico o encargado" as Operador
boundary FrmGarantias as Lista
control OrdenServicioService
control ClienteService
control EquipoService
control GarantiaService
participant OrdenServicioRepository
participant ClienteRepository
participant EquipoRepository
participant GarantiaRepository
group Consulta de garantías
    Operador -> Lista : Abrir Garantías
    Lista -> Lista : Verificar permiso OrdenesVer
    Lista -> ClienteService : Listar(true)
    ClienteService -> ClienteRepository : Listar(true)
    ClienteRepository --> ClienteService : List<Cliente>
    ClienteService --> Lista : List<Cliente>
    Lista -> EquipoService : Listar(true)
    EquipoService -> EquipoRepository : Listar(true)
    EquipoRepository --> EquipoService : List<Equipo>
    EquipoService --> Lista : List<Equipo>
    Lista -> OrdenServicioService : Listar(true)
    OrdenServicioService -> OrdenServicioRepository : Listar(true)
    OrdenServicioRepository --> OrdenServicioService : List<OrdenServicio>
    OrdenServicioService --> Lista : List<OrdenServicio>
    loop Por cada orden
        Lista -> GarantiaService : ObtenerPorOrden(idOrden)
        GarantiaService -> GarantiaRepository : ObtenerPorOrden(idOrden)
        GarantiaRepository --> GarantiaService : Garantia o null
        alt Cobertura encontrada
            GarantiaService --> Lista : Garantia
        else Sin cobertura
            GarantiaService --> Lista : ReglaNegocioException
        end
    end
    opt Cliente o equipo no disponible en caché
        Lista -> ClienteService : ObtenerPorId(idCliente)
        ClienteService -> ClienteRepository : ObtenerPorId(idCliente)
        ClienteRepository --> ClienteService : Cliente o null
        ClienteService --> Lista : Cliente o null
        Lista -> EquipoService : ObtenerPorId(idEquipo)
        EquipoService -> EquipoRepository : ObtenerPorId(idEquipo)
        EquipoRepository --> EquipoService : Equipo o null
        EquipoService --> Lista : Equipo o null
    end
    Lista -> Lista : Aplicar filtro de vigencia y número
    Lista --> Operador : Mostrar garantías
end
@enduml
