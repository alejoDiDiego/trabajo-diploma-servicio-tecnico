@startuml
title N02-11 - Clases de información afectadas

left to right direction
skinparam classAttributeIconSize 0

class Garantia {
    + Id : int
    + IdOrdenOriginal : int
    + FechaInicio : DateTime
    + FechaFin : DateTime
    + Observaciones : string
    + Anulada : bool
    --
    - Garantia()
    + {static} CrearNuevo(idOrdenOriginal : int, fechaInicio : DateTime, fechaFin : DateTime, observaciones : string) : Garantia
    + {static} CargarDesdeDB(id : int, idOrdenOriginal : int, fechaInicio : DateTime, fechaFin : DateTime, observaciones : string, anulada : bool) : Garantia
}

class EvaluacionGarantia {
    + Id : int
    + IdOrdenReingreso : int
    + IdGarantia : int
    + Estado : string
    + Fecha : DateTime
    + IdUsuario : int
    + Motivo : string
    + Observaciones : string
    --
    - EvaluacionGarantia()
    + {static} CrearPendiente(idOrdenReingreso : int, idGarantia : int, idUsuario : int) : EvaluacionGarantia
    + {static} CargarDesdeDB(id : int, idOrdenReingreso : int, idGarantia : int, estado : string, fecha : DateTime, idUsuario : int, motivo : string, observaciones : string) : EvaluacionGarantia
}

class OrdenServicio {
    + Id : int
    + NumeroOrden : int
    + IdCliente : int
    + IdEquipo : int
    + IdTecnicoAsignado : int?
    + IdOrdenOrigen : int?
    + TipoOrden : string
    + Estado : string
    + Resultado : string
    + FechaIngreso : DateTime
    + ProblemaInformado : string
    + EstadoFisicoIngreso : string
    + AccesoriosIngreso : string
    + ObservacionesIngreso : string
    + ObservacionResultado : string
    + IdUsuarioAlta : int
    --
    - OrdenServicio()
    + {static} CrearNuevo(idCliente : int, idEquipo : int, problema : string, estadoFisico : string, accesorios : string, observacionesIngreso : string, idUsuarioAlta : int) : OrdenServicio
    + {static} CrearNuevoGarantia(idCliente : int, idEquipo : int, idOrdenOrigen : int, problema : string, estadoFisico : string, accesorios : string, observacionesIngreso : string, idUsuarioAlta : int) : OrdenServicio
    + {static} CargarDesdeDB(id : int, numeroOrden : int, idCliente : int, idEquipo : int, idTecnicoAsignado : int?, idOrdenOrigen : int?, tipoOrden : string, estado : string, resultado : string, fechaIngreso : DateTime, problemaInformado : string, estadoFisicoIngreso : string, accesoriosIngreso : string, observacionesIngreso : string, observacionResultado : string, idUsuarioAlta : int) : OrdenServicio
    + AsignarTecnico(idTecnico : int) : void
    + ActualizarRecepcion(problema : string, estadoFisico : string, accesorios : string, observacionesIngreso : string) : void
    + IniciarDiagnostico() : void
    + MarcarPendientePresupuesto() : void
    + MarcarPendientePresupuestoDesdeEvaluacion() : void
    + MarcarEsperandoRespuesta() : void
    + AutorizarReparacion() : void
    + MarcarNoReparable(motivo : string) : void
    + MarcarPresupuestoRechazado(motivo : string) : void
    + IniciarReparacion() : void
    + FinalizarReparacion() : void
    + SolicitarAdicional() : void
    + RevertirAPendientePresupuesto() : void
    + CancelarSolicitudAdicional(estadoOrigen : string) : void
    + FinalizarPruebasAprobadas() : void
    + FinalizarPruebasRequiereRevision() : void
    + Cancelar(motivo : string) : void
    + Entregar() : void
    + CancelarEntrega() : void
    + MarcarPendienteEvaluacionGarantia() : void
    + AutorizarReparacionGarantia() : void
    + MarcarGarantiaNoCubierta(motivo : string) : void
    + ReabrirPruebas() : void
}

class Cliente {
    + Id : int
    + Nombre : string
    + Apellido : string
    + Documento : string
    + Telefono : string
    + Email : string
    + Direccion : string
    + Observaciones : string
    + Activo : bool
    + FechaAlta : DateTime
    --
    - Cliente()
    + {static} CrearNuevo(nombre : string, apellido : string, documento : string, telefono : string, email : string, direccion : string, observaciones : string) : Cliente
    + {static} CargarDesdeDB(id : int, nombre : string, apellido : string, documento : string, telefono : string, email : string, direccion : string, observaciones : string, activo : bool, fechaAlta : DateTime) : Cliente
}

class Equipo {
    + Id : int
    + IdCliente : int
    + IdTipoEquipo : int
    + IdMarca : int
    + Modelo : string
    + NumeroSerie : string
    + Imei : string
    + Color : string
    + Observaciones : string
    + Activo : bool
    --
    - Equipo()
    + {static} CrearNuevo(idCliente : int, idTipoEquipo : int, idMarca : int, modelo : string, numeroSerie : string, imei : string, color : string, observaciones : string) : Equipo
    + {static} CargarDesdeDB(id : int, idCliente : int, idTipoEquipo : int, idMarca : int, modelo : string, numeroSerie : string, imei : string, color : string, observaciones : string, activo : bool) : Equipo
}

class HistorialEstadoOrden {
    + Id : int
    + IdOrden : int
    + EstadoAnterior : string
    + EstadoNuevo : string
    + FechaHora : DateTime
    + IdUsuario : int
    + Observacion : string
    --
    - HistorialEstadoOrden()
    + {static} CrearNuevo(idOrden : int, estadoAnterior : string, estadoNuevo : string, idUsuario : int, observacion : string) : HistorialEstadoOrden
    + {static} CargarDesdeDB(id : int, idOrden : int, estadoAnterior : string, estadoNuevo : string, fechaHora : DateTime, idUsuario : int, observacion : string) : HistorialEstadoOrden
}

class Usuario {
    + Id : int
    + Username : string
    + Password : string
    + Activo : bool
    + DVH : string
    --
    - Usuario()
    + {static} CrearNuevo(userName : string, password : string) : Usuario
    + {static} CargarDesdeDB(id : int, userName : string, password : string, dvh : string = "", activo : bool = true) : Usuario
    + Desactivar() : void
    + Reactivar() : void
    + SetDVH(dvh : string) : void
}

class EntradaBitacora {
    + Id : int
    + Fecha : DateTime
    + Usuario : string
    + Actividad : string
    + Detalle : string
    + TipoActividad : string
    --
    - EntradaBitacora()
    + {static} Crear(id : int, fecha : DateTime, usuario : string, actividad : string, detalle : string, tipoActividad : string) : EntradaBitacora
}

Cliente "1" .. "0..*" Equipo : IdCliente
Cliente "1" .. "0..*" OrdenServicio : IdCliente
Equipo "1" .. "0..*" OrdenServicio : IdEquipo

OrdenServicio "0..1" .. "0..*" OrdenServicio : IdOrdenOrigen
OrdenServicio "1" .. "0..1" Garantia : IdOrdenOriginal
OrdenServicio "1" .. "0..1" EvaluacionGarantia : IdOrdenReingreso
Garantia "1" .. "0..*" EvaluacionGarantia : IdGarantia

Usuario "1" .. "0..*" EvaluacionGarantia : IdUsuario del registro pendiente
OrdenServicio "1" .. "0..*" HistorialEstadoOrden : IdOrden
Usuario "1" .. "0..*" HistorialEstadoOrden : IdUsuario actuante

note bottom of Garantia
No hay un método de instancia para renovar cobertura.
Las pantallas de este caso no ofrecen alta o anulación manual.
end note

note bottom of EvaluacionGarantia
No contiene una propiedad ContinuarPago.
El destino se refleja en la orden y su historial.
No tiene un método de instancia Evaluar.
end note

note bottom of EntradaBitacora
El actor de la decisión se conserva como texto.
No existe una referencia de objeto a EvaluacionGarantia.
end note

@enduml
