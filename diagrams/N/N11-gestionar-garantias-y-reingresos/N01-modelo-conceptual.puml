@startuml
title N01.4.7 - Modelo conceptual de garantías y reingresos

left to right direction
hide methods
skinparam classAttributeIconSize 0

class OrdenServicio {
    identificador
    numeroOrden
    cliente
    equipo
    tipoOrden
    ordenOrigen
    estado
    resultado
    fechaIngreso
    problemaInformado
}

class Garantia {
    identificador
    ordenOriginal
    fechaInicio
    fechaFin
    observaciones
    anulada
}

class EvaluacionGarantia {
    identificador
    ordenReingreso
    garantia
    estado
    fecha
    usuarioRegistroPendiente
    motivo
    observaciones
}

class Cliente {
    identificador
    nombre
    apellido
    documento
    activo
}

class Equipo {
    identificador
    propietarioActual
    modelo
    numeroSerie
    activo
}

class Usuario {
    identificador
    nombreUsuario
    activo
}

class HistorialEstadoOrden {
    identificador
    orden
    estadoAnterior
    estadoNuevo
    fechaHora
    usuarioResponsable
    observacion
}

Cliente "1" -- "0..*" Equipo : propietario actual
Cliente "1" -- "0..*" OrdenServicio : cliente de recepción
Equipo "1" -- "0..*" OrdenServicio

OrdenServicio "0..1" -- "0..*" OrdenServicio : original / reingresos
OrdenServicio "1" -- "0..1" Garantia : cobertura del original
OrdenServicio "1" -- "0..1" EvaluacionGarantia : evaluación del reingreso
Garantia "1" -- "0..*" EvaluacionGarantia

Usuario "1" -- "0..*" EvaluacionGarantia : registró evaluación pendiente
OrdenServicio "1" -- "0..*" HistorialEstadoOrden
Usuario "1" -- "0..*" HistorialEstadoOrden : usuario actuante

note bottom of OrdenServicio
El original no se reinicia.
La condición de solo consulta se deriva
de la existencia de un reingreso.
end note

note bottom of EvaluacionGarantia
La decisión y el destino operativo son distintos.
El usuario de la decisión queda identificado
en historial y bitácora.
end note

@enduml
