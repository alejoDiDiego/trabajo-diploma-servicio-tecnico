@startuml
title N02-10 - Secuencia de Gestión de entrega
autonumber
hide footbox
actor "Recepcionista o encargado" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
participant OrdenServicioRepository
participant EntregaRepository
group Consulta de entrega
    Operador -> Detalle : Abrir pestaña Entrega
    Detalle -> OrdenServicioService : ObtenerEntrega(idOrden)
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> EntregaRepository : ObtenerPorOrden(idOrden)
    EntregaRepository --> OrdenServicioService : Entrega o null
    OrdenServicioService --> Detalle : Entrega o null
    Detalle --> Operador : Mostrar datos y acciones
end
@enduml
