@startuml
title N02-10 - Cancelación de entrega
autonumber
hide footbox
actor "Recepcionista o encargado" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
control BitacoraService
participant OrdenServicioRepository
participant EntregaRepository
participant BitacoraRepository
group Cancelación
    Operador -> Detalle : Cancelar entrega
    Detalle -> Detalle : Verificar permiso y entrega existente
    Detalle -> OrdenServicioService : EsSoloConsultaPorReingresos(idOrden)
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService --> Detalle : bool
    alt Orden bloqueada
        Detalle --> Operador : Informar bloqueo
    else Orden no bloqueada
        Detalle --> Operador : Solicitar confirmación
        Operador -> Detalle : Confirmar
        Detalle --> Operador : Solicitar motivo
        Operador -> Detalle : Informar motivo
        Detalle -> OrdenServicioService : CancelarEntrega(idOrden, motivo)
        OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
        OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
        OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
        OrdenServicioRepository --> OrdenServicioService : bool
        OrdenServicioService -> EntregaRepository : ObtenerPorOrden(idOrden)
        EntregaRepository --> OrdenServicioService : Entrega o null
        alt Entrega existente
            opt Reingreso de garantía con orden origen
                OrdenServicioService -> OrdenServicioRepository : ObtenerReingresoGarantiaAbierto(idOrdenOrigen)
                OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
            end
            alt Sin hermano abierto
                OrdenServicioService -> OrdenServicioService : ordenDb.CancelarEntrega()
                OrdenServicioService -> EntregaRepository : CancelarEntregaConTransicion(idOrden, estadoAnterior, estadoNuevo, limpiarResultado, idUsuario, observacion)
                EntregaRepository -> EntregaRepository : Eliminar entrega física y actualizar estado, resultado e historial
                EntregaRepository --> OrdenServicioService : int
                alt codigoResultado = 0
                    OrdenServicioService -> BitacoraService : Registrar("ENTREGA_CANCELADA", detalle, "ORDENES")
                    BitacoraService -> BitacoraRepository : Insertar(entrada)
                    BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
                    BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
                    OrdenServicioService --> Detalle : Finalización sin excepción (void)
                    Detalle -> Detalle : CargarOrden()
                    Detalle --> Operador : Confirmar cancelación
                else codigoResultado = -1
                    OrdenServicioService --> Detalle : ReingresoGarantiaAbiertoException
                    Detalle --> Operador : Informar hermano abierto
                else codigoResultado = -2
                    OrdenServicioService --> Detalle : OrdenOriginalSoloConsultaException
                    Detalle --> Operador : Informar bloqueo
                end
            else Hermano abierto
                OrdenServicioService --> Detalle : ReingresoGarantiaAbiertoException
                Detalle --> Operador : Informar hermano abierto
            end
        else Entrega ausente
            OrdenServicioService --> Detalle : ReglaNegocioException
            Detalle --> Operador : Informar impedimento
        end
    end
end
@enduml
