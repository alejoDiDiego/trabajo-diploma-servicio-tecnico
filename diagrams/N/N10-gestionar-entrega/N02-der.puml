@startuml
title N02-10 - Entidades afectadas por Gestión de entrega

hide circle
skinparam linetype ortho

entity OrdenesServicio {
    * id_orden : int <<PK, IDENTITY(1,1)>>
    --
    * numero_orden : int
    * id_cliente : int <<FK Clientes.id_cliente>>
    * id_equipo : int <<FK Equipos.id_equipo>>
    id_tecnico_asignado : int <<FK Usuarios.id_usuario, NULL>>
    id_orden_origen : int <<FK, NULL>>
    * tipo_orden : nvarchar(20) <<DEFAULT 'Normal'>>
    * estado : nvarchar(50)
    resultado : nvarchar(50) <<NULL>>
    * fecha_ingreso : datetime <<DEFAULT GETDATE()>>
    * problema_informado : nvarchar(max)
    estado_fisico_ingreso : nvarchar(max) <<NULL>>
    accesorios_ingreso : nvarchar(max) <<NULL>>
    observaciones_ingreso : nvarchar(max) <<NULL>>
    observacion_resultado : nvarchar(max) <<NULL>>
    * id_usuario_alta : int <<FK Usuarios.id_usuario>>
}

entity Entregas {
    * id_entrega : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * fecha_entrega : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK>>
    * entregado_a : nvarchar(200)
    documento_receptor : nvarchar(100) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity Garantias {
    * id_garantia : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden_original : int <<FK>>
    * fecha_inicio : datetime
    * fecha_fin : datetime
    observaciones : nvarchar(max) <<NULL>>
    * anulada : bit <<DEFAULT 0>>
}

entity Presupuestos {
    * id_presupuesto : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * tipo : nvarchar(20) <<DEFAULT 'Original'>>
    * fecha_emision : datetime <<DEFAULT GETDATE()>>
    * estado : nvarchar(20) <<DEFAULT 'Pendiente'>>
    * subtotal : decimal(18,2) <<DEFAULT 0>>
    * descuento : decimal(18,2) <<DEFAULT 0>>
    * total : decimal(18,2) <<DEFAULT 0>>
    * dias_garantia : int <<DEFAULT 0>>
    fecha_respuesta : datetime <<NULL>>
    medio_respuesta : nvarchar(100) <<NULL>>
    motivo_rechazo : nvarchar(max) <<NULL>>
    motivo_anulacion : nvarchar(500) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity EvaluacionesGarantia {
    * id_evaluacion : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden_reingreso : int <<FK>>
    * id_garantia : int <<FK>>
    * estado : nvarchar(20) <<DEFAULT 'Pendiente'>>
    * fecha : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK>>
    motivo : nvarchar(max) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity HistorialOrdenes {
    * id_historial : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    estado_anterior : nvarchar(50) <<NULL>>
    * estado_nuevo : nvarchar(50)
    * fecha_hora : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK>>
    observacion : nvarchar(max) <<NULL>>
}

entity Usuarios {
    * id_usuario : int <<PK, IDENTITY(1,1)>>
    --
    * username : nvarchar(100)
    * password : nvarchar(max)
    * activo : bit <<DEFAULT 1>>
    * dvh : nvarchar(100) <<DEFAULT ''>>
}

entity Bitacora {
    * id_bitacora : int <<PK, IDENTITY(1,1)>>
    --
    * fecha : datetime
    * usuario : nvarchar(100)
    * actividad : nvarchar(200)
    * detalle : nvarchar(max) <<DEFAULT ''>>
    * tipo_actividad : nvarchar(50)
}

OrdenesServicio "1" -- "0..1" Entregas : id_orden
Usuarios "1" -- "0..*" Entregas : id_usuario

OrdenesServicio "1" -- "0..1" Garantias : id_orden_original
OrdenesServicio "1" -- "0..*" Presupuestos : id_orden
OrdenesServicio "0..1" -- "0..*" OrdenesServicio : id_orden_origen

OrdenesServicio "1" -- "0..1" EvaluacionesGarantia : id_orden_reingreso
Garantias "1" -- "0..*" EvaluacionesGarantia : id_garantia
Usuarios "1" -- "0..*" EvaluacionesGarantia : id_usuario

OrdenesServicio "1" -- "0..*" HistorialOrdenes : id_orden
Usuarios "1" -- "0..*" HistorialOrdenes : id_usuario

legend bottom
* = NOT NULL.
NULL = admite valores nulos.
Sin DEFAULT indicado = sin valor predeterminado
declarado para una tabla nueva.
endlegend

note right of Entregas
UX_Entrega_Orden(id_orden).
Como máximo una entrega vigente por orden.
No existe columna de cancelación lógica.
end note

note right of Garantias
UX_Garantias_OrdenOriginal(id_orden_original),
sin filtro por anulada.

Las fechas no tienen DEFAULT
en la creación nueva.
end note

note right of Presupuestos
UX_Presupuesto_Original(id_orden)
WHERE tipo = 'Original' AND estado <> 'Anulado'.
end note

note right of EvaluacionesGarantia
UX_EvaluacionesGarantia_Reingreso(id_orden_reingreso).
Se consulta para determinar hermanos abiertos.
end note

note right of Bitacora
Sin FK a Entregas, OrdenesServicio o Usuarios.
El actor y la actuación son texto.
fecha no tiene DEFAULT SQL.
end note

@enduml
