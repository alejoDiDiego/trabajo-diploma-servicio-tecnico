@startuml
title N02-16 - Secuencia de Consulta de dashboard y reportes
autonumber
hide footbox
actor "Encargado, administrador o usuario autorizado" as Operador
boundary FrmDashboard as Dashboard
control ReporteService
participant ReporteRepository
group Dashboard
    Operador -> Dashboard : Abrir dashboard
    Dashboard -> Dashboard : Verificar permiso ReportesVer
    Dashboard -> ReporteService : DashboardResumen()
    ReporteService -> ReporteRepository : DashboardResumen()
    ReporteRepository --> ReporteService : DataTable de una fila y seis escalares
    ReporteService --> Dashboard : DataTable
    Dashboard --> Operador : Mostrar seis tarjetas
    Operador -> Dashboard : Actualizar
    Dashboard -> ReporteService : DashboardResumen()
    ReporteService -> ReporteRepository : DashboardResumen()
    ReporteRepository --> ReporteService : DataTable de una fila y seis escalares
    ReporteService --> Dashboard : DataTable
    Dashboard --> Operador : Refrescar tarjetas
end
@enduml
