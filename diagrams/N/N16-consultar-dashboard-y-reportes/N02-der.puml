@startuml
title N02-16 - Entidades consultadas por dashboard y reportes

hide circle
skinparam linetype ortho

entity OrdenesServicio {
    * id_orden : int <<PK, IDENTITY(1,1)>>
    --
    * numero_orden : int
    * id_cliente : int <<FK Clientes.id_cliente>>
    * id_equipo : int <<FK Equipos.id_equipo>>
    id_tecnico_asignado : int <<FK, NULL>>
    id_orden_origen : int <<FK, NULL>>
    * tipo_orden : nvarchar(20) <<DEFAULT 'Normal'>>
    * estado : nvarchar(50)
    resultado : nvarchar(50) <<NULL>>
    * fecha_ingreso : datetime <<DEFAULT GETDATE()>>
    * problema_informado : nvarchar(max)
    estado_fisico_ingreso : nvarchar(max) <<NULL>>
    accesorios_ingreso : nvarchar(max) <<NULL>>
    observaciones_ingreso : nvarchar(max) <<NULL>>
    observacion_resultado : nvarchar(max) <<NULL>>
    * id_usuario_alta : int <<FK>>
}

entity Reparaciones {
    * id_reparacion : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * numero_intervencion : int
    * id_usuario_tecnico : int <<FK>>
    * fecha_inicio : datetime <<DEFAULT GETDATE()>>
    fecha_fin : datetime <<NULL>>
    trabajo_realizado : nvarchar(max) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity ReparacionRepuesto {
    * id_consumo : int <<PK, IDENTITY(1,1)>>
    --
    * id_reparacion : int <<FK>>
    * id_repuesto : int <<FK>>
    * cantidad : int
    * costo_unitario : decimal(18,2) <<DEFAULT 0>>
}

entity Repuestos {
    * id_repuesto : int <<PK, IDENTITY(1,1)>>
    --
    * codigo : nvarchar(50)
    * descripcion : nvarchar(200)
    * stock_actual : int <<DEFAULT 0>>
    * stock_minimo : int <<DEFAULT 0>>
    * costo_actual : decimal(18,2) <<DEFAULT 0>>
    * precio_referencia : decimal(18,2) <<DEFAULT 0>>
    * activo : bit <<DEFAULT 1>>
}

entity Presupuestos {
    * id_presupuesto : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * tipo : nvarchar(20) <<DEFAULT 'Original'>>
    * fecha_emision : datetime <<DEFAULT GETDATE()>>
    * estado : nvarchar(20) <<DEFAULT 'Pendiente'>>
    * subtotal : decimal(18,2) <<DEFAULT 0>>
    * descuento : decimal(18,2) <<DEFAULT 0>>
    * total : decimal(18,2) <<DEFAULT 0>>
    * dias_garantia : int <<DEFAULT 0>>
    fecha_respuesta : datetime <<NULL>>
    medio_respuesta : nvarchar(100) <<NULL>>
    motivo_rechazo : nvarchar(max) <<NULL>>
    motivo_anulacion : nvarchar(500) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity Entregas {
    * id_entrega : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * fecha_entrega : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK>>
    * entregado_a : nvarchar(200)
    documento_receptor : nvarchar(100) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity Compras {
    * id_compra : int <<PK, IDENTITY(1,1)>>
    --
    * id_proveedor : int <<FK>>
    * fecha : datetime <<DEFAULT GETDATE()>>
    * estado : nvarchar(20) <<DEFAULT 'Borrador'>>
    * total : decimal(18,2) <<DEFAULT 0>>
    * id_usuario : int <<FK>>
    observaciones : nvarchar(max) <<NULL>>
    motivo_anulacion : nvarchar(500) <<NULL>>
}

entity Proveedores {
    * id_proveedor : int <<PK, IDENTITY(1,1)>>
    --
    * razon_social : nvarchar(200)
    cuit : nvarchar(20) <<NULL>>
    telefono : nvarchar(100) <<NULL>>
    email : nvarchar(200) <<NULL>>
    direccion : nvarchar(300) <<NULL>>
    contacto : nvarchar(200) <<NULL>>
    * activo : bit <<DEFAULT 1>>
}

entity EvaluacionesGarantia {
    * id_evaluacion : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden_reingreso : int <<FK>>
    * id_garantia : int <<FK Garantias.id_garantia>>
    * estado : nvarchar(20) <<DEFAULT 'Pendiente'>>
    * fecha : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK>>
    motivo : nvarchar(max) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity Usuarios {
    * id_usuario : int <<PK, IDENTITY(1,1)>>
    --
    * username : nvarchar(100)
    * password : nvarchar(max)
    * activo : bit <<DEFAULT 1>>
    * dvh : nvarchar(100) <<DEFAULT ''>>
}

OrdenesServicio "1" -- "0..*" Reparaciones
Usuarios "1" -- "0..*" Reparaciones : id_usuario_tecnico
Reparaciones "1" -- "0..*" ReparacionRepuesto
Repuestos "1" -- "0..*" ReparacionRepuesto

OrdenesServicio "1" -- "0..*" Presupuestos
OrdenesServicio "1" -- "0..1" Entregas
OrdenesServicio "1" -- "0..1" EvaluacionesGarantia

Proveedores "1" -- "0..*" Compras
Usuarios "1" -- "0..*" Compras
Usuarios "1" -- "0..*" Entregas
Usuarios "1" -- "0..*" EvaluacionesGarantia

Usuarios "0..1" -- "0..*" OrdenesServicio : id_tecnico_asignado
Usuarios "1" -- "0..*" OrdenesServicio : id_usuario_alta
OrdenesServicio "0..1" -- "0..*" OrdenesServicio : id_orden_origen

legend bottom
* = NOT NULL.
NULL = admite valores nulos.
Sin DEFAULT indicado = sin valor predeterminado
declarado para una tabla nueva.
endlegend

note right of OrdenesServicio
UX_OrdenesServicio_Numero(numero_orden).
end note

note right of Reparaciones
UX_Reparaciones_Orden_Nro(id_orden, numero_intervencion).
end note

note right of ReparacionRepuesto
IX_ReparacionRepuesto_Rep_Rep
(id_reparacion, id_repuesto) NO es único.
end note

note right of Repuestos
UX_Repuestos_Codigo(codigo).
end note

note right of Presupuestos
UX_Presupuesto_Original(id_orden)
WHERE tipo='Original' AND estado<>'Anulado'.
end note

note right of Entregas
UX_Entrega_Orden(id_orden).
end note

note right of Proveedores
UX_Proveedores_RazonSocial(razon_social).
end note

note right of EvaluacionesGarantia
UX_EvaluacionesGarantia_Reingreso(id_orden_reingreso).
La cobertura referenciada no se consulta directamente aquí.
end note

note right of Usuarios
UX_Usuarios_Username(username).
No se muestran valores de credenciales.
end note

@enduml
