@startuml
title N02-01 - Secuencia de Gestión de clientes
autonumber
hide footbox
actor "Recepcionista o encargado" as Operador
boundary FrmClientes as Pantalla
control ClienteService as Servicio
participant ClienteRepository as Repositorio
group Carga del listado
    Operador -> Pantalla : Abrir Clientes
    Pantalla -> Pantalla : Verificar permiso ClientesVer
    alt Acceso permitido
        Pantalla -> Servicio : Listar(incluirInactivos)
        Servicio -> Repositorio : Listar(incluirInactivos)
        Repositorio --> Servicio : List<Cliente>
        Servicio --> Pantalla : List<Cliente>
        Pantalla -> Pantalla : AplicarFiltro()
        Pantalla --> Operador : Mostrar listado
    else Acceso denegado
        Pantalla --> Operador : Informar acceso denegado
    end
end
group Cambio de criterios
    alt Cambia incluir inactivos
        Operador -> Pantalla : Cambiar incluir inactivos
        Pantalla -> Servicio : Listar(incluirInactivos)
        Servicio -> Repositorio : Listar(incluirInactivos)
        Repositorio --> Servicio : List<Cliente>
        Servicio --> Pantalla : List<Cliente>
    else Cambia nombre, apellido o documento
        Operador -> Pantalla : Cambiar texto de filtro
    end
    Pantalla -> Pantalla : AplicarFiltro()
    Pantalla --> Operador : Mostrar coincidencias
end
@enduml
