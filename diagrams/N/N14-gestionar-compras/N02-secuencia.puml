@startuml
title N02-14 - Secuencia de Gestión de compras
autonumber
hide footbox
actor "Responsable de compras o encargado" as Operador
boundary FrmCompras as Lista
boundary FrmCompraDetalle as Detalle
control CompraService
control ProveedorService
control RepuestoService
participant CompraRepository
participant ProveedorRepository
participant RepuestoRepository
group Listado
    Operador -> Lista : Abrir Compras
    Lista -> Lista : Verificar permiso ComprasVer
    Lista -> ProveedorService : Listar(true)
    ProveedorService -> ProveedorRepository : Listar(true)
    ProveedorRepository --> ProveedorService : List<Proveedor>
    ProveedorService --> Lista : List<Proveedor>
    Lista -> CompraService : Listar()
    CompraService -> CompraRepository : Listar(true)
    CompraRepository --> CompraService : List<Compra>
    CompraService --> Lista : List<Compra>
    Lista -> Lista : Aplicar filtros locales
    Lista --> Operador : Mostrar compras
end
group Detalle
    Operador -> Lista : Crear o abrir compra
    Lista -> Detalle : Mostrar detalle
    Detalle -> ProveedorService : Listar(true)
    ProveedorService -> ProveedorRepository : Listar(true)
    ProveedorRepository --> ProveedorService : List<Proveedor>
    ProveedorService --> Detalle : List<Proveedor>
    Detalle -> RepuestoService : Listar(false)
    RepuestoService -> RepuestoRepository : Listar(false)
    RepuestoRepository --> RepuestoService : List<Repuesto>
    RepuestoService --> Detalle : List<Repuesto>
    alt Compra nueva
        Detalle -> Detalle : Preparar renglones en memoria sin escribir
        Detalle --> Operador : Mostrar compra nueva
    else Compra existente
        Detalle -> CompraService : ObtenerPorId(idCompra)
        CompraService -> CompraRepository : ObtenerPorId(idCompra)
        CompraRepository --> CompraService : Compra o null
        CompraService --> Detalle : Compra
        Detalle -> CompraService : ListarDetalle(idCompra)
        CompraService -> CompraRepository : ObtenerPorId(idCompra)
        CompraRepository --> CompraService : Compra o null
        CompraService -> CompraRepository : ListarDetalle(idCompra)
        CompraRepository --> CompraService : List<DetalleCompra>
        CompraService --> Detalle : List<DetalleCompra>
        Detalle --> Operador : Mostrar compra persistida
    end
end
@enduml
