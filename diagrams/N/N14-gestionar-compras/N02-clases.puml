@startuml
title N02-14 - Clases de información de Gestión de compras

left to right direction
skinparam classAttributeIconSize 0

class Compra {
    + Id : int
    + IdProveedor : int
    + Fecha : DateTime
    + Estado : string
    + Total : decimal
    + IdUsuario : int
    + Observaciones : string
    + MotivoAnulacion : string
    --
    - Compra()
    + {static} CrearBorrador(idProveedor : int, idUsuario : int, observaciones : string) : Compra
    + CancelarBorrador() : void
    + AnularConfirmada(motivo : string) : void
    + {static} CargarDesdeDB(id : int, idProveedor : int, fecha : DateTime, estado : string, total : decimal, idUsuario : int, observaciones : string, motivoAnulacion : string = null) : Compra
}

class DetalleCompra {
    + Id : int
    + IdCompra : int
    + IdRepuesto : int
    + Cantidad : int
    + CostoUnitario : decimal
    + Subtotal : decimal
    --
    - DetalleCompra()
    + {static} CrearNuevo(idCompra : int, idRepuesto : int, cantidad : int, costoUnitario : decimal) : DetalleCompra
    + {static} CargarDesdeDB(id : int, idCompra : int, idRepuesto : int, cantidad : int, costoUnitario : decimal, subtotal : decimal) : DetalleCompra
}

class EstadoCompra <<static>> {
    + {static} Borrador : string = "Borrador" <<const>>
    + {static} Confirmada : string = "Confirmada" <<const>>
    + {static} Cancelada : string = "Cancelada" <<const>>
}

class Proveedor {
    + Id : int
    + RazonSocial : string
    + Cuit : string
    + Telefono : string
    + Email : string
    + Direccion : string
    + Contacto : string
    + Activo : bool
    --
    - Proveedor()
    + {static} CrearNuevo(razonSocial : string, cuit : string, telefono : string, email : string, direccion : string, contacto : string) : Proveedor
    + {static} CargarDesdeDB(id : int, razonSocial : string, cuit : string, telefono : string, email : string, direccion : string, contacto : string, activo : bool) : Proveedor
}

class Repuesto {
    + Id : int
    + Codigo : string
    + Descripcion : string
    + StockActual : int
    + StockMinimo : int
    + CostoActual : decimal
    + PrecioReferencia : decimal
    + Activo : bool
    --
    - Repuesto()
    + {static} CrearNuevo(codigo : string, descripcion : string, stockInicial : int, stockMinimo : int, costoActual : decimal, precioReferencia : decimal) : Repuesto
    + {static} CargarDesdeDB(id : int, codigo : string, descripcion : string, stockActual : int, stockMinimo : int, costoActual : decimal, precioReferencia : decimal, activo : bool) : Repuesto
}

class MovimientoStock {
    + Id : int
    + IdRepuesto : int
    + Fecha : DateTime
    + Tipo : string
    + Cantidad : int
    + StockAnterior : int
    + StockPosterior : int
    + IdUsuario : int
    + IdCompra : int?
    + IdReparacion : int?
    + Observacion : string
    --
    - MovimientoStock()
    + {static} CrearNuevo(idRepuesto : int, tipo : string, cantidad : int, stockAnterior : int, stockPosterior : int, idUsuario : int, observacion : string, idCompra : int? = null, idReparacion : int? = null) : MovimientoStock
    + {static} CargarDesdeDB(id : int, idRepuesto : int, fecha : DateTime, tipo : string, cantidad : int, stockAnterior : int, stockPosterior : int, idUsuario : int, idCompra : int?, idReparacion : int?, observacion : string) : MovimientoStock
}

class Usuario {
    + Id : int
    + Username : string
    + Password : string
    + Activo : bool
    + DVH : string
    --
    - Usuario()
    + {static} CrearNuevo(userName : string, password : string) : Usuario
    + {static} CargarDesdeDB(id : int, userName : string, password : string, dvh : string = "", activo : bool = true) : Usuario
    + Desactivar() : void
    + Reactivar() : void
    + SetDVH(dvh : string) : void
}

class EntradaBitacora {
    + Id : int
    + Fecha : DateTime
    + Usuario : string
    + Actividad : string
    + Detalle : string
    + TipoActividad : string
    --
    - EntradaBitacora()
    + {static} Crear(id : int, fecha : DateTime, usuario : string, actividad : string, detalle : string, tipoActividad : string) : EntradaBitacora
}

Proveedor "1" .. "0..*" Compra : IdProveedor
Usuario "1" .. "0..*" Compra : IdUsuario creador
Compra "1" .. "0..*" DetalleCompra : IdCompra
Repuesto "1" .. "0..*" DetalleCompra : IdRepuesto

Compra "0..1" .. "0..*" MovimientoStock : IdCompra
Repuesto "1" .. "0..*" MovimientoStock : IdRepuesto
Usuario "1" .. "0..*" MovimientoStock : IdUsuario actuante
Compra ..> EstadoCompra : valores de Estado

note bottom of Compra
No contiene una colección de detalles declarada.
No existe un método de instancia Confirmar.
end note

note bottom of DetalleCompra
La relación se mantiene mediante identificadores.
Los renglones repetidos son válidos.
end note

note bottom of EntradaBitacora
La referencia a la compra y el actor son texto.
No existe FK a Compra o Usuario.
end note

@enduml
