@startuml
title N02-06 - Entidades de Gestión de presupuestos

hide circle
skinparam linetype ortho

entity OrdenesServicio {
    * id_orden : int <<PK, IDENTITY(1,1)>>
    --
    * numero_orden : int
    * id_cliente : int <<FK Clientes.id_cliente>>
    * id_equipo : int <<FK Equipos.id_equipo>>
    id_tecnico_asignado : int <<FK Usuarios.id_usuario, NULL>>
    id_orden_origen : int <<FK OrdenesServicio.id_orden, NULL>>
    * tipo_orden : nvarchar(20) <<DEFAULT 'Normal'>>
    * estado : nvarchar(50)
    resultado : nvarchar(50) <<NULL>>
    * fecha_ingreso : datetime <<DEFAULT GETDATE()>>
    * problema_informado : nvarchar(max)
    estado_fisico_ingreso : nvarchar(max) <<NULL>>
    accesorios_ingreso : nvarchar(max) <<NULL>>
    observaciones_ingreso : nvarchar(max) <<NULL>>
    observacion_resultado : nvarchar(max) <<NULL>>
    * id_usuario_alta : int <<FK Usuarios.id_usuario>>
}

entity Presupuestos {
    * id_presupuesto : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * tipo : nvarchar(20) <<DEFAULT 'Original'>>
    * fecha_emision : datetime <<DEFAULT GETDATE()>>
    * estado : nvarchar(20) <<DEFAULT 'Pendiente'>>
    * subtotal : decimal(18,2) <<DEFAULT 0>>
    * descuento : decimal(18,2) <<DEFAULT 0>>
    * total : decimal(18,2) <<DEFAULT 0>>
    * dias_garantia : int <<DEFAULT 0>>
    fecha_respuesta : datetime <<NULL>>
    medio_respuesta : nvarchar(100) <<NULL>>
    motivo_rechazo : nvarchar(max) <<NULL>>
    motivo_anulacion : nvarchar(500) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity PresupuestoDetalle {
    * id_detalle : int <<PK, IDENTITY(1,1)>>
    --
    * id_presupuesto : int <<FK>>
    id_repuesto : int <<FK, NULL>>
    * tipo_item : nvarchar(20)
    * descripcion : nvarchar(max)
    * cantidad : int
    * precio_unitario : decimal(18,2)
    * subtotal : decimal(18,2)
}

entity Repuestos {
    * id_repuesto : int <<PK, IDENTITY(1,1)>>
    --
    * codigo : nvarchar(50)
    * descripcion : nvarchar(200)
    * stock_actual : int <<DEFAULT 0>>
    * stock_minimo : int <<DEFAULT 0>>
    * costo_actual : decimal(18,2) <<DEFAULT 0>>
    * precio_referencia : decimal(18,2) <<DEFAULT 0>>
    * activo : bit <<DEFAULT 1>>
}

entity Diagnosticos {
    * id_diagnostico : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * id_usuario_tecnico : int <<FK Usuarios.id_usuario>>
    * fecha : datetime <<DEFAULT GETDATE()>>
    * descripcion : nvarchar(max)
    * es_reparable : bit <<DEFAULT 1>>
    tiempo_estimado_dias : int <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity Reparaciones {
    * id_reparacion : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * numero_intervencion : int
    * id_usuario_tecnico : int <<FK Usuarios.id_usuario>>
    * fecha_inicio : datetime <<DEFAULT GETDATE()>>
    fecha_fin : datetime <<NULL>>
    trabajo_realizado : nvarchar(max) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity Pruebas {
    * id_prueba : int <<PK, IDENTITY(1,1)>>
    --
    * id_reparacion : int <<FK>>
    * id_usuario_tecnico : int <<FK Usuarios.id_usuario>>
    * fecha : datetime <<DEFAULT GETDATE()>>
    * descripcion : nvarchar(max)
    * resultado : nvarchar(30)
    observaciones : nvarchar(max) <<NULL>>
    motivo_anulacion : nvarchar(500) <<NULL>>
    fecha_anulacion : datetime <<NULL>>
    id_usuario_anulacion : int <<FK Usuarios.id_usuario, NULL>>
}

entity MovimientosStock {
    * id_movimiento : int <<PK, IDENTITY(1,1)>>
    --
    * id_repuesto : int <<FK>>
    * fecha : datetime <<DEFAULT GETDATE()>>
    * tipo : nvarchar(30)
    * cantidad : int
    * stock_anterior : int
    * stock_posterior : int
    * id_usuario : int <<FK Usuarios.id_usuario>>
    id_compra : int <<FK Compras.id_compra, NULL>>
    id_reparacion : int <<FK, NULL>>
    observacion : nvarchar(max) <<NULL>>
}

entity Entregas {
    * id_entrega : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    * fecha_entrega : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK Usuarios.id_usuario>>
    * entregado_a : nvarchar(200)
    documento_receptor : nvarchar(100) <<NULL>>
    observaciones : nvarchar(max) <<NULL>>
}

entity HistorialOrdenes {
    * id_historial : int <<PK, IDENTITY(1,1)>>
    --
    * id_orden : int <<FK>>
    estado_anterior : nvarchar(50) <<NULL>>
    * estado_nuevo : nvarchar(50)
    * fecha_hora : datetime <<DEFAULT GETDATE()>>
    * id_usuario : int <<FK Usuarios.id_usuario>>
    observacion : nvarchar(max) <<NULL>>
}

entity Usuarios {
    * id_usuario : int <<PK, IDENTITY(1,1)>>
    --
    * username : nvarchar(100)
    * password : nvarchar(max)
    * activo : bit <<DEFAULT 1>>
    * dvh : nvarchar(100) <<DEFAULT ''>>
}

entity Bitacora {
    * id_bitacora : int <<PK, IDENTITY(1,1)>>
    --
    * fecha : datetime
    * usuario : nvarchar(100)
    * actividad : nvarchar(200)
    * detalle : nvarchar(max) <<DEFAULT ''>>
    * tipo_actividad : nvarchar(50)
}

OrdenesServicio "1" -- "0..*" Presupuestos
Presupuestos "1" -- "0..*" PresupuestoDetalle
Repuestos "0..1" -- "0..*" PresupuestoDetalle

OrdenesServicio "1" -- "0..1" Diagnosticos
OrdenesServicio "1" -- "0..*" Reparaciones
Reparaciones "1" -- "0..*" Pruebas
Reparaciones "0..1" -- "0..*" MovimientosStock
Repuestos "1" -- "0..*" MovimientosStock
OrdenesServicio "1" -- "0..1" Entregas
OrdenesServicio "1" -- "0..*" HistorialOrdenes
Usuarios "1" -- "0..*" HistorialOrdenes

legend bottom
* = NOT NULL.
NULL = admite valores nulos.
Sin DEFAULT indicado = sin valor predeterminado
declarado para una tabla nueva.
Las FK anotadas con destino indican su referencia,
aunque el padre no se expanda en este recorte.
endlegend

note right of Presupuestos
UX_Presupuesto_Original(id_orden)
WHERE tipo = 'Original' AND estado <> 'Anulado'.
end note

note right of PresupuestoDetalle
No hay unicidad por presupuesto y repuesto.
La FK de repuesto es opcional en el esquema.
El proceso exige detalle válido no vacío.
end note

note right of Reparaciones
Se consulta para ventanas de anulación.
El rechazo de Adicional puede cerrar
las intervenciones abiertas.
end note

note right of Bitacora
Sin FK a Presupuestos, OrdenesServicio o Usuarios.
La actuación se identifica mediante texto.
end note

@enduml
