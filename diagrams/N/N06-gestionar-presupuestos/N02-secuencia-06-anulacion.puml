@startuml
title N02-06 - Ventanas de anulación
autonumber
hide footbox
actor "Recepcionista, encargado o técnico" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
control BitacoraService
participant OrdenServicioRepository
participant PresupuestoRepository
participant ReparacionRepository
participant EntregaRepository
participant BitacoraRepository
group Anulación de presupuesto
    Operador -> Detalle : Anular presupuesto con motivo
    Detalle -> Detalle : Verificar permiso PresupuestosDecidir
    Detalle -> OrdenServicioService : AnularPresupuesto(idPresupuesto, motivo)
    OrdenServicioService -> PresupuestoRepository : ObtenerPorId(idPresupuesto)
    PresupuestoRepository --> OrdenServicioService : Presupuesto o null
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    group Motivo no vacío: captura estadoAnterior = presupuestoDb.Estado y estadoOrdenAnterior = ordenDb.Estado antes de Anular
        OrdenServicioService -> OrdenServicioService : presupuestoDb.Anular(motivo.Trim())
    end
    alt Original aprobado (estadoAnterior = Aprobado)
        OrdenServicioService -> ReparacionRepository : ListarPorOrden(idOrden)
        ReparacionRepository --> OrdenServicioService : List<Reparacion>
        alt Sin reparaciones y orden AutorizadoReparacion
            OrdenServicioService -> OrdenServicioService : ordenDb.RevertirAPendientePresupuesto()
            OrdenServicioService -> PresupuestoRepository : AnularConTransicion(idPresupuesto, motivo, estadoOrdenAnterior, PendientePresupuesto, null, null, "Presupuesto anulado. Motivo: " + motivo, false, idUsuario)
            PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        else Reparaciones iniciadas o estado no admitido
            OrdenServicioService --> Detalle : ReglaNegocioException
        end
    else Original pendiente (estadoAnterior = Pendiente)
        alt Orden EsperandoRespuesta
            OrdenServicioService -> OrdenServicioService : ordenDb.RevertirAPendientePresupuesto()
            OrdenServicioService -> PresupuestoRepository : AnularConTransicion(...)
            PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        else Estado no admitido
            OrdenServicioService --> Detalle : ReglaNegocioException
        end
    else Original rechazado (estadoAnterior = Rechazado)
        OrdenServicioService -> EntregaRepository : ObtenerPorOrden(idOrden)
        EntregaRepository --> OrdenServicioService : Entrega o null
        OrdenServicioService -> PresupuestoRepository : ListarPorOrden(idOrden)
        PresupuestoRepository --> OrdenServicioService : List<Presupuesto>
        alt Orden ListoRetiro con resultado PresupuestoRechazado y sin entrega
            OrdenServicioService -> PresupuestoRepository : AnularRechazadoConTransicion(presupuestoDb.Id, presupuestoDb.MotivoAnulacion, estadoOrdenAnterior, PendientePresupuesto,\nCombineObservacion(ordenDb.ObservacionResultado, presupuestoDb.MotivoAnulacion), "Presupuesto anulado. Motivo: " + presupuestoDb.MotivoAnulacion, idUsuario)
            PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        else Orden o documentos posteriores no admitidos
            OrdenServicioService --> Detalle : ReglaNegocioException
        end
    else Adicional pendiente (estadoAnterior = Pendiente)
        alt Orden EsperandoRespuesta
            OrdenServicioService -> OrdenServicioService : ordenDb.RevertirAPendientePresupuesto()
            OrdenServicioService -> PresupuestoRepository : AnularConTransicion(...)
            PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        else Estado no admitido
            OrdenServicioService --> Detalle : ReglaNegocioException
        end
    else Adicional aprobado (estadoAnterior = Aprobado)
        OrdenServicioService -> PresupuestoRepository : HasActividadPosterior(idPresupuesto)
        PresupuestoRepository --> OrdenServicioService : bool
        alt Sin actividad operativa posterior
            OrdenServicioService -> OrdenServicioService : ordenDb.RevertirAPendientePresupuesto()
            OrdenServicioService -> PresupuestoRepository : AnularConTransicion(...)
            PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        else Actividad posterior detectada
            OrdenServicioService --> Detalle : ReglaNegocioException
        end
    else Adicional rechazado (estadoAnterior = Rechazado)
        OrdenServicioService -> EntregaRepository : ObtenerPorOrden(idOrden)
        EntregaRepository --> OrdenServicioService : Entrega o null
        OrdenServicioService -> PresupuestoRepository : ListarPorOrden(idOrden)
        PresupuestoRepository --> OrdenServicioService : List<Presupuesto>
        alt Orden ListoRetiro con resultado PresupuestoRechazado y sin entrega
            OrdenServicioService -> PresupuestoRepository : AnularRechazadoConTransicion(presupuestoDb.Id, presupuestoDb.MotivoAnulacion, estadoOrdenAnterior, PendientePresupuesto,\nCombineObservacion(ordenDb.ObservacionResultado, presupuestoDb.MotivoAnulacion), "Presupuesto anulado. Motivo: " + presupuestoDb.MotivoAnulacion, idUsuario)
            PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        else Orden o adicional posterior no admitidos
            OrdenServicioService --> Detalle : ReglaNegocioException
        end
    end
    opt Anulación persistida sin excepción
        OrdenServicioService -> BitacoraService : Registrar("PRESUPUESTO_ANULADO", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Finalización sin excepción (void)
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar anulación
    end
end
@enduml
