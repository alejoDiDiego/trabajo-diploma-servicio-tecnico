@startuml
title N02-06 - Aprobación y rechazo
autonumber
hide footbox
actor "Recepcionista, encargado o técnico" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
control BitacoraService
participant OrdenServicioRepository
participant PresupuestoRepository
participant HistorialEstadoOrdenRepository
participant BitacoraRepository
group Aprobación de original
    Operador -> Detalle : Aprobar original
    Detalle -> Detalle : Verificar permiso PresupuestosDecidir
    Detalle -> OrdenServicioService : RegistrarAprobacionPresupuesto(idOrden, medioRespuesta, observaciones)
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService -> PresupuestoRepository : ObtenerPorOrden(idOrden)
    PresupuestoRepository --> OrdenServicioService : Presupuesto o null
    alt Original emitido y orden modificable
        OrdenServicioService -> OrdenServicioService : presupuestoDb.Aprobar(medioRespuesta, observaciones)
        OrdenServicioService -> OrdenServicioService : ordenDb.AutorizarReparacion()
        OrdenServicioService -> PresupuestoRepository : AprobarConTransicion(idPresupuesto, idOrden, estadoAnterior, estadoNuevo, idUsuario, medioRespuesta, observaciones, "Presupuesto aprobado")
        PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService -> BitacoraService : Registrar("Presupuesto aprobado", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Finalización sin excepción (void)
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar aprobación
    else Documento u orden no admitidos
        OrdenServicioService --> Detalle : ReglaNegocioException
        Detalle --> Operador : Informar impedimento
    end
end
group Rechazo de original
    Operador -> Detalle : Rechazar original con motivo
    Detalle -> OrdenServicioService : RegistrarRechazoPresupuesto(idOrden, motivo, medioRespuesta, observaciones)
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService -> PresupuestoRepository : ObtenerPorOrden(idOrden)
    PresupuestoRepository --> OrdenServicioService : Presupuesto o null
    alt Original emitido y orden modificable
        OrdenServicioService -> OrdenServicioService : presupuestoDb.Rechazar(motivo, medioRespuesta, observaciones)
        OrdenServicioService -> OrdenServicioService : ordenDb.MarcarPresupuestoRechazado(motivo)
        OrdenServicioService -> PresupuestoRepository : RechazarConTransicion(...)
        PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService -> BitacoraService : Registrar("Presupuesto rechazado", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Finalización sin excepción (void)
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar rechazo
    else Documento u orden no admitidos
        OrdenServicioService --> Detalle : ReglaNegocioException
        Detalle --> Operador : Informar impedimento
    end
end
group Aprobación de adicional
    Operador -> Detalle : Aprobar adicional
    Detalle -> OrdenServicioService : RegistrarAprobacionAdicional(idPresupuesto, medioRespuesta, observaciones)
    OrdenServicioService -> PresupuestoRepository : ObtenerPorId(idPresupuesto)
    PresupuestoRepository --> OrdenServicioService : Presupuesto o null
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService -> HistorialEstadoOrdenRepository : ListarPorOrden(idOrden)
    HistorialEstadoOrdenRepository --> OrdenServicioService : List<HistorialEstadoOrden>
    alt Adicional en EsperandoRespuesta con origen de solicitud
        OrdenServicioService -> OrdenServicioService : presupuestoDb.Aprobar(medioRespuesta, observaciones)
        OrdenServicioService -> OrdenServicioService : ordenDb.AutorizarReparacion() si estadoDestino = AutorizadoReparacion
        OrdenServicioService -> PresupuestoRepository : AprobarAdicionalConTransicion(idPresupuesto, idUsuario, medioRespuesta, observaciones, estadoDestino)
        PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService -> BitacoraService : Registrar("ADICIONAL_APROBADO", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Finalización sin excepción (void)
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar aprobación
    else Adicional u orden no admitidos
        OrdenServicioService --> Detalle : ReglaNegocioException
        Detalle --> Operador : Informar impedimento
    end
end
group Rechazo de adicional
    Operador -> Detalle : Rechazar adicional con motivo
    Detalle -> OrdenServicioService : RegistrarRechazoAdicional(idPresupuesto, motivo, medioRespuesta, observaciones)
    OrdenServicioService -> PresupuestoRepository : ObtenerPorId(idPresupuesto)
    PresupuestoRepository --> OrdenServicioService : Presupuesto o null
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    alt Adicional y orden modificables
        OrdenServicioService -> OrdenServicioService : presupuestoDb.Rechazar(motivo, medioRespuesta, observaciones)
        OrdenServicioService -> OrdenServicioService : ordenDb.MarcarPresupuestoRechazado(motivo)
        OrdenServicioService -> PresupuestoRepository : RechazarAdicionalConTransicion(...)
        PresupuestoRepository --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService -> BitacoraService : Registrar("ADICIONAL_RECHAZADO", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Finalización sin excepción (void)
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar rechazo
    else Adicional u orden no admitidos
        OrdenServicioService --> Detalle : ReglaNegocioException
        Detalle --> Operador : Informar impedimento
    end
end
@enduml
