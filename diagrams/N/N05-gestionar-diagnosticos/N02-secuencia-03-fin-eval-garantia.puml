@startuml
title N02-05 - Finalización y evaluación pendiente de garantía
autonumber
hide footbox
actor "Técnico, encargado o recepcionista" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
control BitacoraService
participant OrdenServicioRepository
participant DiagnosticoRepository
participant GarantiaRepository
participant EvaluacionGarantiaRepository
participant BitacoraRepository
group Transacción de diagnóstico
    Operador -> Detalle : Completar datos y finalizar
    Detalle -> Detalle : Validar descripción y días
    Detalle -> OrdenServicioService : FinalizarDiagnostico(idOrden, descripcion, esReparable, tiempoEstimadoDias, observaciones)
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService -> DiagnosticoRepository : ObtenerPorOrden(idOrden)
    DiagnosticoRepository --> OrdenServicioService : Diagnostico o null
    alt Orden EnDiagnostico con técnico y sin diagnóstico previo
        OrdenServicioService -> OrdenServicioService : Diagnostico.CrearNuevo(...)
        alt Diagnóstico reparable
            alt Orden de garantía
                OrdenServicioService -> OrdenServicioService : ordenDb.MarcarPendienteEvaluacionGarantia()
            else Orden normal
                OrdenServicioService -> OrdenServicioService : ordenDb.MarcarPendientePresupuesto()
            end
        else Diagnóstico no reparable
            OrdenServicioService -> OrdenServicioService : ordenDb.MarcarNoReparable(descripcion)
        end
        OrdenServicioService -> DiagnosticoRepository : CrearConTransicion(diagnostico, estadoAnterior, estadoNuevo, idUsuario, observacion, resultado, observacionResultado)
        DiagnosticoRepository --> OrdenServicioService : Diagnostico
    else Estado, técnico o diagnóstico inválido
        OrdenServicioService --> Detalle : ReglaNegocioException
        Detalle --> Operador : Informar impedimento
    end
end
group Transacción separada de evaluación pendiente
    opt Diagnóstico persistido, reparable y TipoOrden Garantia
        alt Orden origen informado
            OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrdenOrigen)
            OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
            alt Original existente y mismo equipo
                OrdenServicioService -> GarantiaRepository : ObtenerVigente(original.Id)
                GarantiaRepository --> OrdenServicioService : Garantia o null
                alt Cobertura vigente
                    OrdenServicioService -> EvaluacionGarantiaRepository : ObtenerPorReingreso(idReingreso)
                    EvaluacionGarantiaRepository --> OrdenServicioService : EvaluacionGarantia o null
                    alt Sin evaluación previa
                        OrdenServicioService -> EvaluacionGarantiaRepository : Crear(evaluacionPendiente)
                        EvaluacionGarantiaRepository --> OrdenServicioService : EvaluacionGarantia
                    else Evaluación duplicada
                        OrdenServicioService --> Detalle : ReglaNegocioException
                        Detalle --> Operador : Informar impedimento
                    end
                else Cobertura ausente
                    OrdenServicioService --> Detalle : ReglaNegocioException
                    Detalle --> Operador : Informar impedimento
                end
            else Original ausente o equipo distinto
                OrdenServicioService --> Detalle : ReglaNegocioException
                Detalle --> Operador : Informar impedimento
            end
        else Orden origen no informado
            OrdenServicioService --> Detalle : ReglaNegocioException
            Detalle --> Operador : Informar impedimento
        end
    end
end
opt FinalizarDiagnostico completó sin excepción (diagnóstico persistido y evaluación creada si corresponde)
    group Cierre
        OrdenServicioService -> BitacoraService : Registrar("Diagnostico finalizado", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Diagnostico
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Mostrar conclusión no editable
    end
end
@enduml
