@startuml
title N01.4.1 - Modelo conceptual de Gestión de diagnósticos

left to right direction
hide methods
skinparam classAttributeIconSize 0

class OrdenServicio {
    identificador
    numeroOrden
    tipoOrden
    estado
    resultado
    problemaInformado
    tecnicoAsignado
    ordenOrigen
    observacionResultado
}

class Diagnostico {
    identificador
    orden
    tecnicoResponsable
    fecha
    descripcion
    esReparable
    tiempoEstimadoDias
    observaciones
}

class Usuario {
    identificador
    nombreUsuario
    activo
}

class HistorialEstadoOrden {
    identificador
    orden
    estadoAnterior
    estadoNuevo
    fechaHora
    usuarioResponsable
    observacion
}

class Garantia {
    identificador
    ordenOriginal
    fechaInicio
    fechaFin
    observaciones
    anulada
}

class EvaluacionGarantia {
    identificador
    ordenReingreso
    garantia
    estado
    fecha
    usuarioResponsable
    motivo
    observaciones
}

OrdenServicio "1" -- "0..1" Diagnostico
Usuario "1" -- "0..*" Diagnostico : técnico atribuido

OrdenServicio "1" -- "0..*" HistorialEstadoOrden
Usuario "1" -- "0..*" HistorialEstadoOrden : usuario actuante

OrdenServicio "1" -- "0..1" Garantia : cobertura del original
OrdenServicio "1" -- "0..1" EvaluacionGarantia : evaluación del reingreso
Garantia "1" -- "0..*" EvaluacionGarantia
Usuario "1" -- "0..*" EvaluacionGarantia : usuario actuante

OrdenServicio "0..1" -- "0..*" OrdenServicio : origen / reingresos

note bottom of EvaluacionGarantia
Aquí solamente se prepara la evaluación Pendiente.
La aceptación o rechazo pertenece
a Gestión de garantías y reingresos.
end note

@enduml
