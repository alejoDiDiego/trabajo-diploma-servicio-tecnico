@startuml
title N02-07 - Inicio de reparación e intervención adicional
autonumber
hide footbox
actor "Técnico, encargado o recepcionista" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
control BitacoraService
participant OrdenServicioRepository
participant ReparacionRepository
participant UsuarioRepository
participant UsuarioPermisoService
participant UsuarioPermisoRepository
participant PermisoRepository
participant BitacoraRepository
group Inicio de reparación
    Operador -> Detalle : Iniciar reparación
    Detalle -> Detalle : Verificar permiso OrdenesEditar
    Detalle -> OrdenServicioService : IniciarReparacion(idOrden)
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    alt Orden con técnico asignado
        OrdenServicioService -> UsuarioRepository : ObtenerPorId(idTecnico)
        UsuarioRepository --> OrdenServicioService : Usuario o null
        OrdenServicioService -> UsuarioPermisoService : ListarPermisosEfectivos(idTecnico)
        UsuarioPermisoService -> UsuarioRepository : ObtenerPorId(idTecnico)
        UsuarioRepository --> UsuarioPermisoService : Usuario
        UsuarioPermisoService -> UsuarioPermisoRepository : ListarPermisosAsignados(idTecnico)
        UsuarioPermisoRepository --> UsuarioPermisoService : List<PermisoComponent>
        loop Por cada familia asignada entre permisosAsignados
            UsuarioPermisoService -> PermisoRepository : ListarSubArbol(permisoAsignado.Id)
            PermisoRepository --> UsuarioPermisoService : List<PermisoComponent>
        end
        UsuarioPermisoService --> OrdenServicioService : List<PermisoComponent>
        alt Técnico elegible
            alt Orden AutorizadoReparacion
                OrdenServicioService -> OrdenServicioService : ordenDb.IniciarReparacion()
                OrdenServicioService -> ReparacionRepository : IniciarReparacion(idOrden, idTecnico, idUsuario)
                ReparacionRepository -> ReparacionRepository : Crear intervención, actualizar orden e insertar historial
                ReparacionRepository --> OrdenServicioService : int
            else Orden EnReparacion
                OrdenServicioService -> ReparacionRepository : ObtenerAbierta(idOrden)
                ReparacionRepository --> OrdenServicioService : Reparacion o null
                alt Sin intervención abierta
                    OrdenServicioService -> ReparacionRepository : IniciarIntervencionAdicional(idOrden, idTecnico, idUsuario)
                    ReparacionRepository -> ReparacionRepository : Crear intervención adicional sin historial
                    ReparacionRepository --> OrdenServicioService : int
                else Intervención abierta existente
                    OrdenServicioService --> Detalle : ReglaNegocioException
                end
            else Estado no admitido
                OrdenServicioService --> Detalle : ReglaNegocioException
            end
            opt Inicio persistido
                OrdenServicioService -> BitacoraService : Registrar("Reparacion iniciada", detalle, "ORDENES")
                BitacoraService -> BitacoraRepository : Insertar(entrada)
                BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
                BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
                OrdenServicioService -> ReparacionRepository : ObtenerPorId(idReparacion)
                ReparacionRepository --> OrdenServicioService : Reparacion
                OrdenServicioService --> Detalle : Reparacion
                Detalle -> Detalle : CargarOrden()
                Detalle --> Operador : Mostrar reparación iniciada
            end
        else Técnico no elegible
            OrdenServicioService --> Detalle : ReglaNegocioException
            Detalle --> Operador : Informar impedimento
        end
    else Orden sin técnico o bloqueada
        OrdenServicioService --> Detalle : ReglaNegocioException u OrdenOriginalSoloConsultaException
        Detalle --> Operador : Informar impedimento
    end
end
@enduml
