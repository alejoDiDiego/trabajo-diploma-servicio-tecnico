@startuml
title N02-07 - Secuencia de Gestión de reparaciones
autonumber
hide footbox
actor "Técnico, encargado o recepcionista" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
participant OrdenServicioRepository
participant ReparacionRepository
group Consulta de reparaciones
    Operador -> Detalle : Abrir pestaña Reparaciones
    Detalle -> OrdenServicioService : ListarReparaciones(idOrden)
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> ReparacionRepository : ListarPorOrden(idOrden)
    ReparacionRepository --> OrdenServicioService : List<Reparacion>
    OrdenServicioService --> Detalle : List<Reparacion>
    Detalle -> Detalle : Seleccionar intervención por defecto
    Detalle --> Operador : Mostrar grilla
end
group Consulta de una intervención
    Operador -> Detalle : Seleccionar intervención
    Detalle -> OrdenServicioService : ObtenerReparacion(idReparacion)
    OrdenServicioService -> ReparacionRepository : ObtenerPorId(idReparacion)
    ReparacionRepository --> OrdenServicioService : Reparacion o null
    alt Intervención existente
        OrdenServicioService --> Detalle : Reparacion
        Detalle --> Operador : Mostrar datos de la intervención
    else Intervención inexistente
        OrdenServicioService --> Detalle : ReglaNegocioException
        Detalle --> Operador : Informar impedimento
    end
end
@enduml
