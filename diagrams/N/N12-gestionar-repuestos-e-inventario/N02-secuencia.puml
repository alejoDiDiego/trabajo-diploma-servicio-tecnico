@startuml
title N02-12 - Secuencia de Gestión de repuestos e inventario
autonumber
hide footbox
actor "Responsable de inventario o encargado" as Operador
boundary FrmRepuestos as Maestro
boundary FrmRepuestoEditar as Editor
control RepuestoService
participant RepuestoRepository
group Catálogo
    Operador -> Maestro : Abrir Repuestos
    Maestro -> Maestro : Verificar permiso RepuestosVer
    Maestro -> RepuestoService : Listar(incluirInactivos)
    RepuestoService -> RepuestoRepository : Listar(incluirInactivos)
    RepuestoRepository --> RepuestoService : List<Repuesto>
    RepuestoService --> Maestro : List<Repuesto>
    Maestro -> Maestro : Aplicar filtros locales
    Maestro --> Operador : Mostrar catálogo
end
group Apertura del editor
    Operador -> Maestro : Crear o editar
    Maestro -> Maestro : Verificar permiso RepuestosCrear o RepuestosEditar
    Maestro -> Editor : Abrir formulario
    Editor -> Editor : Validar código, descripción y referencias
    Editor --> Maestro : Datos aceptados o cierre cancelado
end
@enduml
