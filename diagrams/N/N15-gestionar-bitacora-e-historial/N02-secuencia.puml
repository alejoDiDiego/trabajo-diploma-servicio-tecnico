@startuml
title N02-15 - Secuencia de Gestión de bitácora e historial
autonumber
hide footbox
actor "Personal autorizado" as Operador
boundary FrmBitacora as PantallaBitacora
control BitacoraService
participant BitacoraRepository
group Consulta de bitácora
    Operador -> PantallaBitacora : Abrir bitácora
    PantallaBitacora -> BitacoraService : ObtenerTiposActividad()
    BitacoraService --> PantallaBitacora : string[]
    PantallaBitacora -> PantallaBitacora : Verificar permiso y preparar grilla
    alt Acceso permitido
        PantallaBitacora -> BitacoraService : Buscar(usuario, desde, hasta, tipoActividad)
        BitacoraService -> BitacoraRepository : Buscar(usuario, desde, hasta, tipoActividad)
        BitacoraRepository --> BitacoraService : List<EntradaBitacora>
        BitacoraService --> PantallaBitacora : List<EntradaBitacora>
        PantallaBitacora --> Operador : Mostrar grilla de solo lectura
    else Acceso denegado
        PantallaBitacora --> Operador : Informar acceso denegado
    end
    loop Consulta con filtros
        Operador -> PantallaBitacora : Ajustar usuario, fechas o tipo y Buscar
        PantallaBitacora -> BitacoraService : Buscar(usuario, desde, hasta, tipoActividad)
        BitacoraService -> BitacoraRepository : Buscar(usuario, desde, hasta, tipoActividad)
        BitacoraRepository --> BitacoraService : List<EntradaBitacora>
        BitacoraService --> PantallaBitacora : List<EntradaBitacora>
        PantallaBitacora --> Operador : Presentar coincidencias
    end
end
@enduml
