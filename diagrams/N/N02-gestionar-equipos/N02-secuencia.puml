@startuml
title N02-02 - Secuencia de Gestión de equipos
autonumber
hide footbox
actor "Recepcionista o encargado" as Operador
boundary FrmEquipos as Pantalla
control ClienteService as ClientesSvc
control TipoEquipoService as TiposSvc
control MarcaService as MarcasSvc
control EquipoService as Servicio
participant ClienteRepository as Clientes
participant TipoEquipoRepository as Tipos
participant MarcaRepository as Marcas
participant EquipoRepository as Equipos
group Carga inicial
    Operador -> Pantalla : Abrir Equipos
    Pantalla -> ClientesSvc : Listar(false)
    ClientesSvc -> Clientes : Listar(false)
    Clientes --> ClientesSvc : List<Cliente>
    ClientesSvc --> Pantalla : List<Cliente>
    Pantalla -> TiposSvc : Listar(true)
    TiposSvc -> Tipos : Listar(true)
    Tipos --> TiposSvc : List<TipoEquipo>
    TiposSvc --> Pantalla : List<TipoEquipo>
    Pantalla -> MarcasSvc : Listar(true)
    MarcasSvc -> Marcas : Listar(true)
    Marcas --> MarcasSvc : List<Marca>
    MarcasSvc --> Pantalla : List<Marca>
    Pantalla -> Pantalla : Verificar permiso EquiposVer
    alt Acceso permitido
        alt Cliente seleccionado
            Pantalla -> Servicio : ListarPorCliente(idCliente, incluirInactivos)
            Servicio -> Equipos : ListarPorCliente(idCliente, incluirInactivos)
            Equipos --> Servicio : List<Equipo>
            Servicio --> Pantalla : List<Equipo>
        else Todos los clientes
            Pantalla -> Servicio : Listar(incluirInactivos)
            Servicio -> Equipos : Listar(incluirInactivos)
            Equipos --> Servicio : List<Equipo>
            Servicio --> Pantalla : List<Equipo>
        end
        Pantalla -> Pantalla : AplicarFiltro()
        Pantalla --> Operador : Mostrar equipos
    else Acceso denegado
        Pantalla --> Operador : Informar acceso denegado
    end
end
group Cambio de filtros
    alt Cambia cliente o incluir inactivos
        Operador -> Pantalla : Cambiar cliente o incluir inactivos
        alt Cliente seleccionado
            Pantalla -> Servicio : ListarPorCliente(idCliente, incluirInactivos)
            Servicio -> Equipos : ListarPorCliente(idCliente, incluirInactivos)
            Equipos --> Servicio : List<Equipo>
            Servicio --> Pantalla : List<Equipo>
        else Todos los clientes
            Pantalla -> Servicio : Listar(incluirInactivos)
            Servicio -> Equipos : Listar(incluirInactivos)
            Equipos --> Servicio : List<Equipo>
            Servicio --> Pantalla : List<Equipo>
        end
    else Cambia modelo o número de serie
        Operador -> Pantalla : Cambiar texto de búsqueda
    end
    Pantalla -> Pantalla : AplicarFiltro()
    opt Cliente no disponible en caché
        Pantalla -> ClientesSvc : ObtenerPorId(idCliente)
        ClientesSvc -> Clientes : ObtenerPorId(idCliente)
        Clientes --> ClientesSvc : Cliente o null
        ClientesSvc --> Pantalla : Cliente o null
    end
    Pantalla --> Operador : Mostrar coincidencias
end
@enduml
