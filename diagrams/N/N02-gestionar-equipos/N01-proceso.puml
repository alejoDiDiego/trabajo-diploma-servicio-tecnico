@startuml
title N01.2 - Proceso de Gestión de equipos

|Recepcionista o encargado|
start
:Acceder a Gestión de equipos;

|Sistema|
:Verificar permiso de consulta;

if (¿Acceso permitido?) then (sí)
    :Cargar referencias y listado;
else (no)
    :Informar acceso denegado;
    stop
endif

|Recepcionista o encargado|
:Seleccionar operación;

|Sistema|
:Verificar autorización y selección requerida;

if (¿Consulta?) then (sí)
    |Recepcionista o encargado|
    :Seleccionar cliente, búsqueda e inclusión de inactivos;
    |Sistema|
    :Presentar coincidencias;

elseif (¿Registro o modificación?) then (sí)
    :Presentar formulario de datos;
    |Recepcionista o encargado|
    :Seleccionar cliente, tipo y marca;
    :Completar características;
    :Aceptar;
    |Sistema|
    :Validar referencias obligatorias;
    :Verificar existencia y condición activa;

    if (¿Referencias admitidas?) then (sí)
        :Guardar equipo;
        :Registrar actividad;
        :Actualizar listado;
    else (no)
        :Informar impedimento;
    endif

else (Desactivación o reactivación)
    :Solicitar confirmación;
    |Recepcionista o encargado|

    if (¿Confirma?) then (sí)
        |Sistema|
        :Actualizar condición activa del equipo;
        :Registrar actividad;
        :Actualizar listado;
    else (no)
        |Sistema|
        :Mantener información sin cambios;
    endif
endif

|Recepcionista o encargado|
:Consultar resultado;
stop

@enduml
