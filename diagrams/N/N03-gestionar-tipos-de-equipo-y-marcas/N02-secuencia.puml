@startuml
title N02-03 - Secuencia de Gestión de tipos de equipo y marcas
autonumber
hide footbox
actor "Recepcionista o encargado" as Operador
boundary FrmTiposEquipo as TiposPantalla
boundary FrmCatalogoEditar as Dialogo
control TipoEquipoService as TiposServicio
participant TipoEquipoRepository as TiposRepo
control BitacoraService as Auditoria
participant BitacoraRepository as Bitacora
group Catálogo de tipos de equipo
    Operador -> TiposPantalla : Abrir Tipos de equipo
    TiposPantalla -> TiposPantalla : Verificar permiso TiposEquipoVer
    alt Acceso permitido
        TiposPantalla -> TiposServicio : Listar(incluirInactivos)
        TiposServicio -> TiposRepo : Listar(incluirInactivos)
        TiposRepo --> TiposServicio : List<TipoEquipo>
        TiposServicio --> TiposPantalla : List<TipoEquipo>
        TiposPantalla -> TiposPantalla : AplicarFiltro()
        TiposPantalla --> Operador : Mostrar tipos
    else Acceso denegado
        TiposPantalla --> Operador : Informar acceso denegado
    end
    loop Cambio de filtro
        Operador -> TiposPantalla : Cambiar nombre o incluir inactivos
        alt Cambia incluir inactivos
            TiposPantalla -> TiposServicio : Listar(incluirInactivos)
            TiposServicio -> TiposRepo : Listar(incluirInactivos)
            TiposRepo --> TiposServicio : List<TipoEquipo>
            TiposServicio --> TiposPantalla : List<TipoEquipo>
        end
        TiposPantalla -> TiposPantalla : AplicarFiltro()
    end
    group Alta
        Operador -> TiposPantalla : Crear
        TiposPantalla -> TiposPantalla : Verificar permiso TiposEquipoCrear
        TiposPantalla -> Dialogo : Solicitar nombre nuevo
        Operador -> Dialogo : Ingresar nombre y aceptar
        Dialogo -> Dialogo : Validar nombre obligatorio
        Dialogo --> TiposPantalla : Nombre aceptado
        TiposPantalla -> TiposServicio : Crear(nombre)
        TiposServicio -> TiposRepo : Agregar(tipo)
        TiposRepo --> TiposServicio : TipoEquipo
        TiposServicio -> Auditoria : Registrar("Creacion de tipo de equipo", detalle, "TIPOS_EQUIPO")
        Auditoria -> Bitacora : Insertar(entrada)
        Bitacora --> Auditoria : Finalización sin excepción (void)
        Auditoria --> TiposServicio : Finalización sin excepción (void)
        TiposServicio --> TiposPantalla : TipoEquipo
        TiposPantalla -> TiposServicio : Listar(incluirInactivos)
        TiposServicio -> TiposRepo : Listar(incluirInactivos)
        TiposRepo --> TiposServicio : List<TipoEquipo>
        TiposServicio --> TiposPantalla : List<TipoEquipo>
    end
    group Modificación
        Operador -> TiposPantalla : Editar
        TiposPantalla -> TiposPantalla : Verificar permiso TiposEquipoEditar
        TiposPantalla -> Dialogo : Solicitar nombre precargado
        Operador -> Dialogo : Modificar nombre y aceptar
        Dialogo -> Dialogo : Validar nombre obligatorio
        Dialogo --> TiposPantalla : Nombre aceptado
        TiposPantalla -> TiposServicio : Modificar(id, nombre)
        TiposServicio -> TiposRepo : ObtenerPorId(id)
        TiposRepo --> TiposServicio : TipoEquipo o null
        alt Tipo existente
            TiposServicio -> TiposServicio : TipoEquipo.CargarDesdeDB(id, nombre, activo)
            TiposServicio -> TiposRepo : Modificar(tipoActualizado)
            TiposRepo --> TiposServicio : Finalización sin excepción (void)
            TiposServicio -> Auditoria : Registrar("Modificacion de tipo de equipo", detalle, "TIPOS_EQUIPO")
            Auditoria -> Bitacora : Insertar(entrada)
            Bitacora --> Auditoria : Finalización sin excepción (void)
            Auditoria --> TiposServicio : Finalización sin excepción (void)
            TiposServicio --> TiposPantalla : TipoEquipo
        else Tipo inexistente
            TiposServicio --> TiposPantalla : ReglaNegocioException
        end
    end
    group Desactivación o reactivación
        Operador -> TiposPantalla : Desactivar o reactivar
        TiposPantalla -> TiposPantalla : Verificar permiso TiposEquipoDesactivar
        TiposPantalla --> Operador : Solicitar confirmación
        Operador -> TiposPantalla : Confirmar
        alt Desactivación
            TiposPantalla -> TiposServicio : Desactivar(id)
        else Reactivación
            TiposPantalla -> TiposServicio : Reactivar(id)
        end
        TiposServicio -> TiposRepo : ObtenerPorId(id)
        TiposRepo --> TiposServicio : TipoEquipo o null
        alt Tipo existente
            alt Desactivación
                TiposServicio -> TiposRepo : Desactivar(id)
            else Reactivación
                TiposServicio -> TiposRepo : Reactivar(id)
            end
            TiposRepo --> TiposServicio : Finalización sin excepción (void)
            TiposServicio -> Auditoria : Registrar(cambio, detalle, "TIPOS_EQUIPO")
            Auditoria -> Bitacora : Insertar(entrada)
            Bitacora --> Auditoria : Finalización sin excepción (void)
            Auditoria --> TiposServicio : Finalización sin excepción (void)
            TiposServicio --> TiposPantalla : Finalización sin excepción (void)
        else Tipo inexistente
            TiposServicio --> TiposPantalla : ReglaNegocioException
        end
        TiposPantalla -> TiposServicio : Listar(incluirInactivos)
        TiposServicio -> TiposRepo : Listar(incluirInactivos)
        TiposRepo --> TiposServicio : List<TipoEquipo>
        TiposServicio --> TiposPantalla : List<TipoEquipo>
    end
end
@enduml
