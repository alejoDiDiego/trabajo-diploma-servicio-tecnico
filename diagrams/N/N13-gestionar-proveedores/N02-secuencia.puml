@startuml
title N02-13 - Secuencia de Gestión de proveedores
autonumber
hide footbox
actor "Responsable de compras o encargado" as Operador
boundary FrmProveedores as Lista
boundary FrmProveedorEditar as Editor
control ProveedorService
participant ProveedorRepository
group Consulta
    Operador -> Lista : Abrir Proveedores
    Lista -> Lista : Verificar permiso ProveedoresVer
    alt Acceso permitido
        Lista -> ProveedorService : Listar(incluirInactivos)
        ProveedorService -> ProveedorRepository : Listar(incluirInactivos)
        ProveedorRepository --> ProveedorService : List<Proveedor>
        ProveedorService --> Lista : List<Proveedor>
        Lista -> Lista : Aplicar filtros locales
        Lista --> Operador : Mostrar proveedores
    else Acceso denegado
        Lista --> Operador : Informar acceso denegado
    end
end
group Apertura del editor
    Operador -> Lista : Crear o editar
    Lista -> Lista : Verificar permiso ProveedoresCrear o ProveedoresEditar
    Lista -> Editor : Abrir formulario
    Editor -> Editor : Validar razón social obligatoria
    Editor --> Lista : Datos aceptados o cierre cancelado
end
@enduml
