@startuml
title N02-09 - Registro y anulación de pruebas
autonumber
hide footbox
actor "Técnico, encargado o recepcionista" as Operador
boundary FrmOrdenServicioDetalle as Detalle
control OrdenServicioService
control BitacoraService
participant OrdenServicioRepository
participant ReparacionRepository
participant BitacoraRepository
group Registro
    Operador -> Detalle : Informar datos y registrar
    Detalle -> Detalle : Validar intervención actual y captura
    Detalle -> OrdenServicioService : RegistrarPrueba(idReparacion, descripcion, aprobada, observaciones)
    OrdenServicioService -> ReparacionRepository : ObtenerPorId(idReparacion)
    ReparacionRepository --> OrdenServicioService : Reparacion o null
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService -> ReparacionRepository : ObtenerAbierta(idOrden)
    ReparacionRepository --> OrdenServicioService : Reparacion o null
    OrdenServicioService -> ReparacionRepository : ListarPorOrden(idOrden)
    ReparacionRepository --> OrdenServicioService : List<Reparacion>
    alt Sin intervención abierta y última intervención finalizada
        OrdenServicioService -> ReparacionRepository : RegistrarPrueba(idReparacion, idTecnico, descripcion, resultado, observaciones)
        ReparacionRepository --> OrdenServicioService : int
        OrdenServicioService -> BitacoraService : Registrar("PRUEBA_REGISTRADA", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService -> ReparacionRepository : ObtenerPruebaPorId(idPrueba)
        ReparacionRepository --> OrdenServicioService : Prueba
        OrdenServicioService --> Detalle : Prueba
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar registro
    else Intervención o estado no admitidos
        OrdenServicioService --> Detalle : ReglaNegocioException u OrdenOriginalSoloConsultaException
        Detalle --> Operador : Informar impedimento
    end
end
group Anulación
    Operador -> Detalle : Seleccionar prueba y anular
    Detalle --> Operador : Solicitar confirmación
    Operador -> Detalle : Confirmar
    Detalle --> Operador : Solicitar motivo
    Operador -> Detalle : Informar motivo
    Detalle -> OrdenServicioService : AnularPrueba(idPrueba, motivo)
    OrdenServicioService -> ReparacionRepository : ObtenerPruebaPorId(idPrueba)
    ReparacionRepository --> OrdenServicioService : Prueba o null
    OrdenServicioService -> ReparacionRepository : ObtenerPorId(idReparacion)
    ReparacionRepository --> OrdenServicioService : Reparacion o null
    OrdenServicioService -> OrdenServicioRepository : ObtenerPorId(idOrden)
    OrdenServicioRepository --> OrdenServicioService : OrdenServicio o null
    OrdenServicioService -> OrdenServicioRepository : TieneReingresosGarantia(idOrden)
    OrdenServicioRepository --> OrdenServicioService : bool
    OrdenServicioService -> ReparacionRepository : ListarPorOrden(idOrden)
    ReparacionRepository --> OrdenServicioService : List<Reparacion>
    alt Prueba de la última intervención y orden EnPruebas
        OrdenServicioService -> OrdenServicioService : pruebaDb.Anular(motivo, idUsuario)
        OrdenServicioService -> ReparacionRepository : AnularPrueba(idPrueba, motivo, idUsuario)
        ReparacionRepository --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService -> BitacoraService : Registrar("PRUEBA_ANULADA", detalle, "ORDENES")
        BitacoraService -> BitacoraRepository : Insertar(entrada)
        BitacoraRepository --> BitacoraService : Finalización sin excepción (void)
        BitacoraService --> OrdenServicioService : Finalización sin excepción (void)
        OrdenServicioService --> Detalle : Finalización sin excepción (void)
        Detalle -> Detalle : CargarOrden()
        Detalle --> Operador : Confirmar anulación
    else Prueba, intervención o estado no admitidos
        OrdenServicioService --> Detalle : ReglaNegocioException u OrdenOriginalSoloConsultaException
        Detalle --> Operador : Informar impedimento
    end
end
@enduml
