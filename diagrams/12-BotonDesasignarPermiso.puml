@startuml
title Asignar Permisos - Boton "<" Desasignar Permiso

actor Usuario as U
participant FrmAsignarPermisosUsuario as FAPU
participant SessionManager as SM
participant UsuarioPermisoService as UPS
participant UsuarioPermisoRepository as UPR

U -> FAPU : Click "<" (Quitar)
FAPU -> SM : TienePermiso("PermisosAsignarUsuarios")
SM --> FAPU : true
note right: Usuario seleccionado y\npermiso asignado elegido
FAPU -> UPS : QuitarPermiso(idUsuario, idPermiso)
UPS -> UPS : ValidarUsuario(idUsuario)
UPS -> UPS : ValidarPermiso(idPermiso)
UPS -> UPR : QuitarPermiso(idUsuario, idPermiso)
UPR --> UPS : void
UPS --> FAPU : void
FAPU -> FAPU : CargarPermisosUsuario()
FAPU -> UPS : ListarPermisosDisponibles(idUsuario)
UPS --> FAPU : List<PermisoComponent>
FAPU -> UPS : ListarPermisosAsignados(idUsuario)
UPS --> FAPU : List<PermisoComponent>
FAPU -> FAPU : MessageBox(Exito)

@enduml
