@startuml
title Observer Traducciones - Editar Idioma

actor Usuario as U
participant FrmAdministrarTraducciones as FAT
participant SessionManager as SM
participant IdiomaService as IS
participant IdiomaRepository as IR
participant SesionIdioma as SI
participant FrmAdministrarPermisos as FAP
participant FrmAdministrarTraducciones as FAT2
participant FrmLogin as FL
participant FrmAsignarPermisosUsuario as FAPU
participant FrmAdministrarUsuarios as FAU

U -> FAT : Click "Editar Idioma"
FAT -> SM : TienePermiso("IdiomasEditar")
SM --> FAT : true
note right: _idIdiomaSeleccionado > 0
FAT -> IS : ModificarIdioma(id, nombre)
IS -> IR : ModificarIdioma(id, nombre)
IR --> IS : void
IS --> FAT : void
FAT -> FAT : CargarIdiomas()
FAT -> IS : Listar()
IS --> FAT : List<Idioma>
FAT -> FAT : CargarTraducciones()
FAT -> IS : ListarTraduccionesPorIdioma(id)
IS --> FAT : List<TraduccionEditable>
FAT -> FAT : LimpiarIdioma()
FAT -> FAT : RefrescarIdiomaActual()
FAT -> IS : ObtenerPorId(idIdiomaActual)
IS --> FAT : Idioma
FAT -> SI : CambiarIdioma(idioma)
SI -> SI : idioma = idiomaSeleccionado
SI -> FAP : Actualizar(idioma)
SI -> FAT2 : Actualizar(idioma)
SI -> FL : Actualizar(idioma)
SI -> FAPU : Actualizar(idioma)
SI -> FAU : Actualizar(idioma)
FAT -> FAT : MessageBox(Exito)

@enduml
